# Copy this file to .env.production on the droplet and fill in the
# values. docker-compose.prod.yml reads it via --env-file.
#
#   cp .env.production.example .env.production
#   nano .env.production
#
# DO NOT commit .env.production. It contains secrets.

# ---- Domain & TLS -----------------------------------------------------------
# Email used for Let's Encrypt registration (renewal notices etc.)
LETSENCRYPT_EMAIL=crmorales5dh@gmail.com

# ---- Postgres (used by docker-compose.prod.yml) -----------------------------
POSTGRES_DB=vetdata
POSTGRES_USER=vetdata
# Generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_a_strong_password

# ---- Frontend build args ----------------------------------------------------
# Relative path means the SPA calls /api/v1/... on whatever host it is
# served from, so it works for vetdata.com.br without rebuilding for env.
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_OAUTH_CLIENT_ID=
