# Copy this file to backend/.env.production on the droplet and fill in
# real values. The backend container reads it via env_file.
#
#   cp backend/.env.production.example backend/.env.production
#   nano backend/.env.production
#
# These values must match the Postgres credentials in ../.env.production.

DATABASE_URL=postgresql+asyncpg://vetdata:replace_with_a_strong_password@db:5432/vetdata

# Comma-separated list of allowed origins for CORS. Caddy handles TLS,
# so always use the https:// origins here.
CORS_ORIGINS=https://vetdata.com.br,https://www.vetdata.com.br

# Generate with:  openssl rand -base64 64
AUTH_JWT_SECRET=replace_with_long_random_secret
AUTH_JWT_ACCESS_TTL_MINUTES=15
AUTH_JWT_REFRESH_TTL_DAYS=30

# Optional: leave blank to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=

# Optional: leave blank to disable AI chat features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
